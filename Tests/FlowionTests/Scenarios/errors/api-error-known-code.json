{
  "name": "An error body becomes kind api with the platform's code, status and requestId",
  "call": {
    "operation": "get_charger",
    "path": {
      "chargingStationId": "9f1c2b3a-0000-4000-8000-000000000001"
    }
  },
  "exchange": [
    {
      "expect": {
        "method": "GET",
        "path": "/v1/charging-stations/9f1c2b3a-0000-4000-8000-000000000001"
      },
      "respond": {
        "status": 404,
        "body": {
          "error": "notFound",
          "message": "no such charging station",
          "requestId": "req-404"
        }
      }
    }
  ],
  "expectOutcome": {
    "error": {
      "kind": "api",
      "status": 404,
      "code": "notFound",
      "requestId": "req-404"
    }
  }
}
