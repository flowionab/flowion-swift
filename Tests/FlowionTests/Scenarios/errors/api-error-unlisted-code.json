{
  "name": "A code the SDK does not list, on a status the contract does list, is preserved as the string the platform sent",
  "call": {
    "operation": "get_charger",
    "path": {
      "chargingStationId": "9f1c2b3a-0000-4000-8000-000000000001"
    }
  },
  "exchange": [
    {
      "expect": {
        "method": "GET",
        "path": "/v1/charging-stations/9f1c2b3a-0000-4000-8000-000000000001"
      },
      "respond": {
        "status": 404,
        "body": {
          "error": "aCodeFromTheFuture",
          "message": "newer than this SDK",
          "requestId": "req-future"
        }
      }
    }
  ],
  "expectOutcome": {
    "error": {
      "kind": "api",
      "status": 404,
      "code": "aCodeFromTheFuture",
      "requestId": "req-future"
    }
  }
}
