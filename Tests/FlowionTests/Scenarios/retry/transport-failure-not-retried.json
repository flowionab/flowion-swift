{
  "name": "A transport failure is never retried",
  "client": {
    "retry": {
      "maxAttempts": 4,
      "maxWaitSeconds": 30
    }
  },
  "call": {
    "operation": "get_charger",
    "path": {
      "chargingStationId": "9f1c2b3a-0000-4000-8000-000000000001"
    }
  },
  "exchange": [
    {
      "expect": {
        "method": "GET",
        "path": "/v1/charging-stations/9f1c2b3a-0000-4000-8000-000000000001"
      },
      "respond": {
        "transportError": "connection reset by peer"
      }
    }
  ],
  "expectOutcome": {
    "error": {
      "kind": "transport"
    }
  },
  "expectWaitsSeconds": []
}
