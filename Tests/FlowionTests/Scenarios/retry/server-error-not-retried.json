{
  "name": "A 5xx is never retried, even with attempts to spare",
  "client": {
    "retry": {
      "maxAttempts": 4,
      "maxWaitSeconds": 30
    }
  },
  "call": {
    "operation": "get_charger",
    "path": {
      "chargingStationId": "9f1c2b3a-0000-4000-8000-000000000001"
    }
  },
  "exchange": [
    {
      "expect": {
        "method": "GET",
        "path": "/v1/charging-stations/9f1c2b3a-0000-4000-8000-000000000001"
      },
      "respond": {
        "status": 503,
        "body": {
          "error": "serviceUnavailable",
          "message": "try later",
          "requestId": "req-5xx"
        }
      }
    }
  ],
  "expectOutcome": {
    "error": {
      "kind": "api",
      "status": 503,
      "code": "serviceUnavailable",
      "requestId": "req-5xx"
    }
  },
  "expectWaitsSeconds": []
}
