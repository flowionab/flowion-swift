{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Flowion SDK conformance scenario",
  "description": "One file under sdks/conformance/<area>/. Validated by scripts/lib/conformance-scenarios.test.sh with a deliberately small keyword set (type, required, properties, additionalProperties, enum, items, oneOf, minItems, minLength, minimum, minProperties) so the guard needs nothing but python3.",
  "type": "object",
  "required": ["name", "call", "exchange", "expectOutcome"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1 },
            "maxWaitSeconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "call": {
      "type": "object",
      "required": ["operation"],
      "additionalProperties": false,
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["single", "paginate", "stream"] },
        "path": { "type": "object" },
        "query": { "type": "object" },
        "body": {},
        "stopAfterItems": { "type": "integer", "minimum": 0 }
      }
    },
    "exchange": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["expect", "respond"],
        "additionalProperties": false,
        "properties": {
          "expect": {
            "type": "object",
            "required": ["method", "path"],
            "additionalProperties": false,
            "properties": {
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string", "minLength": 1 },
              "query": { "type": "object" },
              "headers": { "type": "object" }
            }
          },
          "respond": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "status": { "type": "integer", "minimum": 100 },
              "headers": { "type": "object" },
              "body": {},
              "bodyText": { "type": "string" },
              "frames": { "type": "array", "items": { "type": "string" } },
              "transportError": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "expectOutcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ok"],
          "additionalProperties": false,
          "properties": { "ok": {} }
        },
        {
          "type": "object",
          "required": ["error"],
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["transport", "rateLimited", "api", "unexpected"] },
                "code": { "type": "string" },
                "status": { "type": "integer" },
                "requestId": { "type": "string" },
                "retryAfterSeconds": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["items"],
          "additionalProperties": false,
          "properties": {
            "items": { "type": "array" },
            "unrecognized": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "end": { "enum": ["closed", "revoked"] }
          }
        }
      ]
    },
    "expectWaitsSeconds": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "expectRateLimit": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "limit": { "type": ["integer", "null"] },
        "remaining": { "type": ["integer", "null"] },
        "resetSeconds": { "type": ["integer", "null"] },
        "retryAfterSeconds": { "type": ["integer", "null"] }
      }
    }
  }
}
